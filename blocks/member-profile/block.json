{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assemblypress/member-profile",
	"title": "Member Profile",
	"category": "widgets",
	"icon": "id",
	"description": "Display an AssemblyPress member profile.",
	"textdomain": "assemblypress",
	"attributes": {
		"userId": {
			"type": "number",
			"default": 0
		},
		"showFields": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"color": {
			"text": true,
			"background": true,
			"link": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"usesContext": [
		"assemblypress/memberId"
	]
}
