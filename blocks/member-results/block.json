{
	"apiVersion": 3,
	"name": "assemblypress/member-results",
	"title": "Member Results",
	"category": "widgets",
	"icon": "groups",
	"textdomain": "assemblypress",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"usesContext": [
		"assemblypress/perPage",
		"assemblypress/includeAllAccounts",
		"assemblypress/memberId"
	],
	"editorScript": "file:./index.js",
	"ancestor": [
		"assemblypress/member-directory"
	],
	"attributes": {
		"columns": {
			"type": "number",
			"default": 1
		}
	},
	"style": "file:./style.css"
}
